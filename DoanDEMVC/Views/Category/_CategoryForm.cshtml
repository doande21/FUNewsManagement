@model BusinessObjects.Category

<div class="modal-header">
    <h5 class="modal-title">@(Model.CategoryID == 0 ? "Create Category" : "Edit Category")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form id="categoryForm" asp-action="SaveCategory">
    <div class="modal-body">
        <input type="hidden" asp-for="CategoryID" />
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoryDesciption" class="form-label"></label>
            <textarea asp-for="CategoryDesciption" class="form-control"></textarea>
            <span asp-validation-for="CategoryDesciption" class="text-danger"></span>
        </div>
        <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" asp-for="IsActive" value="true">
            <label class="form-check-label" asp-for="IsActive">Is Active</label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>

<!-- Bật Client-side Validation -->
<partial name="_ValidationScriptsPartial" />