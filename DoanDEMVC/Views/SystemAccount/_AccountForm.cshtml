@model BusinessObjects.SystemAccount
<form id="accountForm" asp-action="SaveAccount">
    <div class="modal-header">
        <h5 class="modal-title">Account Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="AccountID" />
        <div class="mb-3">
            <label asp-for="AccountName"></label>
            <input asp-for="AccountName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="AccountEmail"></label>
            <input asp-for="AccountEmail" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="AccountPassword"></label>
            <input asp-for="AccountPassword" type="password" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="AccountRole"></label>
            <select asp-for="AccountRole" class="form-select">
                <option value="1">Staff</option>
                <option value="2">Lecturer</option>
            </select>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>